  "version": "1.0.0",
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=24.10.0 <25",
    "npm": ">=11.6.0 <12"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
